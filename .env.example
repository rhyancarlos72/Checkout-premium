# =============================================================================
# Copie para `.env` (desenvolvimento) ou cadastre cada variável no painel da
# Hostinger (Node.js → Variáveis de ambiente). NUNCA faça commit do .env.
# =============================================================================
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://checkout.seudominio.com.br
CORS_ORIGINS=

# ---------- Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRETA — só no servidor
# Usadas no BUILD do frontend (públicas):
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------- Woovi / OpenPix
WOOVI_APP_ID=
WOOVI_WEBHOOK_SECRET=                 # gere com: openssl rand -hex 24

# ---------- Efí Bank (Pix)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_CERT_BASE64=                      # base64 -w0 certificado.p12
EFI_CERT_PASSPHRASE=
EFI_SANDBOX=false
EFI_WEBHOOK_SECRET=                   # openssl rand -hex 24

# ---------- PayTracking
PAYTRACKING_URL=https://paytracking.com.br/api/webhook.php
PAYTRACKING_TOKEN=
PAYTRACKING_SECRET=

# ---------- E-mail (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com.br
SMTP_PASS=
MAIL_FROM=contato@seudominio.com.br
MAIL_FROM_NAME=Minha Loja

# ---------- Jobs
JOBS_ENABLED=true
CRON_SECRET=                          # openssl rand -hex 24 (opcional)
