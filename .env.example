# =============================================================================
# Copie para `.env` (desenvolvimento) ou cadastre cada variável no painel da
# Hostinger (Node.js → Variáveis de ambiente). NUNCA faça commit do .env.
# =============================================================================
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://checkout.seudominio.com.br
CORS_ORIGINS=

# ---------- Supabase (Project Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SECRETA — só no servidor
SUPABASE_SERVICE_ROLE_KEY=
# pública (anon/publishable) — usada no login do painel
SUPABASE_ANON_KEY=

# Seu e-mail: libera o "Primeiro acesso" (criar a conta admin pelo painel)
ADMIN_EMAIL=

# ---------- Woovi / OpenPix
WOOVI_APP_ID=
# gere com: openssl rand -hex 24
WOOVI_WEBHOOK_SECRET=

# ---------- Efí Bank (Pix)
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# base64 -w0 certificado.p12
EFI_CERT_BASE64=
EFI_CERT_PASSPHRASE=
EFI_SANDBOX=false
# openssl rand -hex 24
EFI_WEBHOOK_SECRET=

# ---------- PayTracking (OPCIONAL)
# Recomendado: configure no painel em Integrações → Webhooks (token e segredo ficam no banco).
# Estas variáveis continuam funcionando como alternativa.
PAYTRACKING_URL=https://paytracking.com.br/api/webhook.php
PAYTRACKING_TOKEN=
PAYTRACKING_SECRET=

# ---------- E-mail (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com.br
SMTP_PASS=
MAIL_FROM=contato@seudominio.com.br
MAIL_FROM_NAME=Minha Loja

# ---------- Jobs
JOBS_ENABLED=true
# openssl rand -hex 24 (opcional)
CRON_SECRET=
